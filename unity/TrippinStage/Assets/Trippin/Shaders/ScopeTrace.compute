// unity_scope: the CRT's phosphor. Each frame the old glow decays and the
// beam's new path (a polyline in screen divisions, x -5..5, y -4..4) is
// written in: r is the sharp trace, g a wide halo. Brightness per segment
// comes from the show (a slow beam leaves a brighter line, as on a real CRT).
#pragma kernel Trace

RWTexture2D<float4> _Out;
float4 _Pts[160];          // xy: position (divisions), z: brightness
int _N;
float4 _Size;              // texture w, h
float _Decay, _Core, _Halo;

[numthreads(8, 8, 1)]
void Trace(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Size.x || id.y >= (uint)_Size.y) return;
    float2 p = float2((id.x + 0.5) / _Size.x * 10.0 - 5.0, (id.y + 0.5) / _Size.y * 8.0 - 4.0);
    float core = 0, halo = 0;
    for (int i = 0; i + 1 < _N; i++)
    {
        float2 a = _Pts[i].xy, b = _Pts[i + 1].xy;
        float2 ab = b - a, ap = p - a;
        float t = saturate(dot(ap, ab) / max(dot(ab, ab), 1e-6));
        float2 q = ap - ab * t;
        float d2 = dot(q, q);
        if (d2 > 0.6) continue;
        float w = _Pts[i].z;
        core += w * exp(-d2 * _Core);
        halo += w * exp(-d2 * _Halo);
    }
    float4 old = _Out[id.xy];
    _Out[id.xy] = float4(old.r * _Decay + core, old.g * _Decay + halo, 0, 1);
}
